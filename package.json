{
  "name": "faxx-hr",
  "version": "0.1.0",
  "private": true,
  "description": "HR aplikace pro hodnocení životopisů s bezpečnostní vrstvou proti prompt injection",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:upload": "node scripts/deploy-upload.mjs",
    "db:init": "wrangler d1 execute faxx-hr --file=migrations/0001_init.sql"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "postal-mime": "^2.2.7",
    "unpdf": "^1.8.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.90.0"
  }
}
